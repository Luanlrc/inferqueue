{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=inferqueue;Username=inferqueue;Password=inferqueue"
  },
  "Llm": {
    "DefaultModel": "gpt-4o-mini"
  },
  "Worker": {
    "BatchSize": 5,
    "PollIntervalSeconds": 2,
    "LeaseSeconds": 120,
    "MaxAttempts": 3,
    "BaseBackoffSeconds": 5,
    "MaxBackoffSeconds": 300,
    "ReaperIntervalSeconds": 30,
    "ReaperBatchSize": 20
  }
}
